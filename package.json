{
  "name": "ether-db",
  "version": "0.1.0",
  "private": true,
  "description": "A persistent JSON key-value database built with TypeScript",
  "type": "module",
  "scripts": {
    "dev": "tsx src/demo.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/demo.js",
    "serve": "tsx src/server.ts",
    "serve:built": "node dist/server.js",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": { "ether-http": "file:../ether-http" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
